  "airline_tails",
  "additional_tail_photos"
 ],
 "parent": {
  "annotations": "dataset/tail_annotations.json",
  "manifest_sha256": "0a2ce2f183a868c9ded710dcbfa3f98bfca7870ac819e19a4eb9ddc1797056d8"
 },
 "split_policy": "Explicit splits. All v1 records keep their v1 split so the v1 test set stays comparable. New groups were assigned by review: the Acroterion series and sessions shared with v1 train go to train; independent new groups are split between validation and test.",
 "screen_against": [
  "full_plane_tests/manifest.json"
 ],
 "review_notes": [
  "All 50 images visually reviewed in local EXIF-transposed contact sheets. Boxes enclose the visible vertical fin with a small margin; horizontal stabilizers, fuselage and background are excluded where a rectangular box permits. Existing occlusions and edge truncation are retained, not reconstructed.",
  "Alaska 1-4 retain legacy faces; 10 retains the standard face within the Kraken special livery. Delta 9-10 retain their T-tail junctions. Southwest 1-5 retain modern unlettered fins, 6-10 older lettered/retro fins. United retains both gold and blue globe liveries.",
  "Shared photographer alone is not proof of a shared session. Conservative session groups use source titles, nearby photo identifiers and visual context. Registrations in SOURCES.md are distinct unless explicitly grouped by session.",
  "Southwest 1-5 have no recorded attribution. Visual review shows different angles/backgrounds/airframes and no matching photograph; each is provisionally independent, with provenance uncertainty retained here and in copied SOURCES.md.",
  "v2 adds 33 attributed photographs from additional_tail_photos. Saved tail crops use the whole image as the tail box; the 11 full-plane Delta and Southwest photographs have reviewed tail boxes enclosing the fin with a small margin (horizontal stabilizer included where a rectangle cannot exclude it).",
  "New test images: Alaska 11, 15; American 06; Delta 02, 05 (ground backgrounds); United 10. New validation images: Alaska 18, American 03, United 05."
 ],
 "group_reasons": {
  "boston-june-2025": "Alaska 6,7,9 and American 8,9: 4300streetcar, Boston departures June 2025; conservatively one cross-airline session.",
  "alaska-aeroprints-8979": "Alaska 2,3: Aeroprints, nearby Flickr IDs 8979588564/8979892540 and similar legacy-fin views; conservatively shared session, different registrations.",
  "delta-redlegsfan21": "Delta 3-6: same photographer and close airport tail studies; conservatively one group despite distinct registrations and photo IDs.",
  "delta-cory-watts": "Delta 9,10: same photographer, distinctive low-angle T-tail studies; conservative source-style group, not claimed identical aircraft.",
  "southwest-aeroprints-8902": "Southwest 7,8: Aeroprints and nearby Flickr IDs 8902938779/8902174939; conservatively one session, different liveries.",
  "boston-november-2025": "United 5,10 (v1 train) and Delta 06-08: 4300streetcar Boston November 2025 departures; conservatively one session, all train.",
  "boston-april-2025": "United 7 (v1 validation) and Alaska 18: 4300streetcar, final approach to Boston, April 2025; conservatively one session, kept in validation.",
  "acroterion": "All Acroterion photographs: BWI MD series (Alaska 05-06, American 11-12, Southwest 01-08, United 01/03/06/14-16) plus American 02 (DCA) and United 11 (IAD). Related to six full-plane stress-test photos; all train by decision, so the full-plane stress set is reported with a contamination caveat.",
  "boston-july-2026": "Alaska 07 and United 20: 4300streetcar Boston departures July 2026; conservatively one session.",
  "boston-december-2024": "Alaska 11 and 15: 4300streetcar final approach to Boston, December 2024; one session, held out for test.",
  "colin-brown-atlanta": "Delta 02 and 05: Colin Brown, Atlanta ground photographs; one group, held out for test (ground backgrounds probe the background bias).",
  "singletons": "Other groups are single images: distinct source photographs and registrations. Shared photographer alone (4300streetcar Alaska 19, February 2025) is not treated as a shared session."
 },
